# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — contains EMAIL_PASSWORD, NEXTAUTH_SECRET, DB credentials
.env*

# local database (contains real user data)
*.db
*.db-journal
prisma/dev.db

# pm2 logs
/logs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# uploads (user-generated content)
/public/uploads/

# claude local settings (may contain command history with credentials)
.claude/settings.local.json
